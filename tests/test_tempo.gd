extends SceneTree
const Tempo = preload("res://scripts/tempo.gd")
const Clock = preload("res://scripts/beat_clock.gd")
func _initialize() -> void: run.call_deferred()
func run() -> void:
	var clock = Clock.new()
	assert(clock.advance(0) == [0])
	for round_number in range(1,36):
		var beat = Tempo.beat_seconds(round_number)
		assert(clock.round_number == round_number)
		assert(clock.advance(beat-0.001) == [])
		assert(clock.advance(0.001) == [1])
		assert(is_equal_approx(clock.selection_progress(),0.5))
		assert(clock.advance(beat-0.001) == [])
		assert(clock.advance(0.001) == [2])
		assert(clock.selection_progress() == 1)
		assert(clock.advance(beat) == [0])
	assert(Tempo.beat_seconds(1) == Tempo.beat_seconds(5))
	assert(Tempo.beat_seconds(15) < Tempo.beat_seconds(10))
	assert(Tempo.beat_seconds(25) == Tempo.beat_seconds(100))
	clock.reset()
	assert(clock.tick == -1 and clock.round_number == 1 and clock.elapsed == 0)
	var game = load("res://main.tscn").instantiate()
	root.add_child(game)
	game.set_process(false)
	game.sound_on = false
	game.awards = load("res://scripts/achievements.gd").new("user://tempo_test.json")
	game.start_game()
	game.round_no = 25
	game.clock.reset(25)
	game.clock.advance(2*Tempo.beat_seconds(25))
	for fighter in game.fighters: fighter.animation_speed = Tempo.animation_speed(25)
	game.present_result(load("res://scripts/rules.gd").resolve(1,2,1,0))
	assert(game.impact_remaining < Tempo.beat_seconds(25))
	for cue in game.rhythm_voice:
		assert(game.rhythm_voice[cue].back().get_length() < Tempo.MIN_BEAT)
	game._process(game.impact_remaining+0.001)
	assert(game.impact_remaining < 0)
	assert(game.fighters[0].projectile_spent and not game.fighters[0].orb.visible)
	assert(game.fighters[1].phase == "guard" and game.fighters[1].recoil_age == 0)
	game.present_result(load("res://scripts/rules.gd").resolve(1,0,1,0))
	assert(game.fighters[0].animation_speed == 1.0)
	game.queue_free()
	await process_frame
	DirAccess.remove_absolute(ProjectSettings.globalize_path("user://tempo_test.json"))
	print("PASS: 35 rounds of equal beats, progressive ramp and cap, reset, fast impact before next round, short voice length, normal-speed finisher")
	quit()
