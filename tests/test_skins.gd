extends SceneTree
const Profile = preload("res://scripts/cosmetics/skin_profile.gd")
const Activation = preload("res://scripts/cosmetics/activation_provider.gd")
const Session = preload("res://scripts/network/duel_session.gd")
const FILE = "user://skins_test.json"
func _initialize() -> void: run.call_deferred()
func run() -> void:
	DirAccess.remove_absolute(ProjectSettings.globalize_path(FILE))
	var profile = Profile.new(FILE)
	assert(profile.owns("cloud") and not profile.owns("tiger"))
	assert(not profile.equip("tiger") and not profile.equip("unknown"))
	assert(profile.check_in("2026-01-01").ok)
	assert(not profile.check_in("2026-01-01").ok)
	assert(not profile.check_in("2025-12-31").ok)
	assert(not profile.check_in("2026-02-30").ok)
	assert(profile.days.size() == 1)
	profile = Profile.new(FILE)
	assert(profile.days.size() == 1)
	assert(profile.check_in("2026-01-04").ok)
	assert(not profile.owns("tiger"))
	assert(profile.check_in("2026-01-10").unlocked)
	assert(profile.owns("tiger") and profile.equip("tiger"))
	profile = Profile.new(FILE)
	assert(profile.equipped == "tiger")
	assert(profile.check_in("2026-01-11").ok)
	assert(not profile.check_in("2026-01-12").unlocked)
	var broken = Profile.new("user://missing_skin_test_folder/profile.json")
	assert(not broken.check_in("2026-01-01").ok and broken.days.is_empty())
	assert(not broken.equip("cloud"))
	assert(not Activation.new().sync_entitlements().ok)
	# Skin IDs are visual only, including missing/unknown IDs from an older peer.
	for id in ["tiger","unknown"]:
		var a = Session.new()
		var b = Session.new()
		a.local_skin = id
		a.outbound.connect(b.receive)
		b.outbound.connect(a.receive)
		b.start(false,100)
		a.start(true,100)
		assert(b.remote_skin == ("tiger" if id == "tiger" else "cloud"))
		assert(a.remote_skin == "cloud")
	var game = load("res://main.tscn").instantiate()
	root.add_child(game)
	game.sound_on = false
	game.skin_profile = profile
	game.show_wardrobe("cloud")
	assert(game.fighters[0].skin_id == "cloud" and profile.equipped == "tiger")
	game.show_home()
	assert(game.fighters[0].skin_id == "tiger" and game.wardrobe == null)
	game.start_game()
	assert(game.fighters[0].reward_parts.visible)
	assert(game.fighters[0].skin_id == "tiger" and game.fighters[1].skin_id == "cloud")
	game.queue_free()
	await process_frame
	DirAccess.remove_absolute(ProjectSettings.globalize_path(FILE))
	print("PASS: daily deduplication, cumulative reward, rollback, persistence, locked equip, save failure, preview isolation, peer skin fallback, inactive server provider")
	quit()
