extends SceneTree
const R = preload("res://scripts/rules.gd")
var game
func _initialize() -> void: run.call_deferred()
func finish(won: bool) -> void:
	game.present_result(R.resolve(1,0,1,0) if won else R.resolve(0,1,0,1))
	for i in range(18): game.update_ending(0.1)
func run() -> void:
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	game.set_process(false)
	game.sound_on = false
	game.awards = load("res://scripts/achievements.gd").new("user://arcade_test.json")
	game.start_arena()
	game.begin_arcade_vs()
	assert(game.state == "arcade_vs" and game.cinematic_action == "fight")
	game._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	var remaining = game.cinematic_remaining
	game._process(20)
	assert(game.cinematic_remaining == remaining and game.cinematic_paused)
	game._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	assert(game.cinematic_paused)
	game.advance_arcade()
	assert(game.state == "battle" and game.fighters[0].is_processing())
	finish(false)
	game._process(4)
	assert(game.state == "battle" and game.arena.score == [0,1])
	finish(false)
	assert(game.cinematic_action == "")
	game._process(20)
	assert(game.state == "result" and game.arena.continues == 0)
	game.continue_arcade()
	game.continue_arcade()
	assert(game.arena.continues == 1 and game.arena.losses == 2)
	game._process(3)
	assert(game.state == "arcade_vs")
	game._process(2)
	assert(game.state == "battle")
	for stage in range(3):
		finish(true)
		game.advance_arcade()
		finish(true)
		assert(game.arena.victories.size() == stage+1)
		game.advance_arcade()
		if stage < 2:
			assert(game.state == "arena_intro" and game.arena.stage == stage+1)
			if stage == 1: assert(game.fighters[1].phase == "boss_ready")
			game.advance_arcade()
			assert(game.state == "arcade_vs")
			game.advance_arcade()
	assert(game.state == "arcade_clear")
	assert(game.arena.wins == 6 and game.arena.total_exchanges == 8)
	assert(game.achievement_text.text.contains("续关 1 次"))
	assert(not game.header.text.contains("无续关"))
	game.show_home()
	assert(not game.route.visible and game.cinematic_action == "")
	game._process(30)
	assert(game.state == "home")
	game.queue_free()
	await process_frame
	DirAccess.remove_absolute(ProjectSettings.globalize_path("user://arcade_test.json"))
	print("PASS: full arcade route, timed/skip advancement, background pause, defeat waits, continue dedup, boss, scorecard, exit cancellation")
	quit()
